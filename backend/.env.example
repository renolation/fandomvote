# App
NODE_ENV=development
PORT=3000
TIMEZONE=Asia/Ho_Chi_Minh

# Database (Neon Postgres) — dùng POOLED connection (host có "-pooler") vì backend dùng
# pg_advisory_xact_lock (an toàn với transaction-mode pooling). Nhớ sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require

# JWT (self-signed) — secrets stay in env, NEVER in platform_config
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=1800
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=2592000

# Google OAuth (ID token verification)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Webhook / postback signing secrets
IAP_WEBHOOK_SECRET=change-me-iap-webhook-secret
OFFERWALL_POSTBACK_SECRET=change-me-offerwall-secret
