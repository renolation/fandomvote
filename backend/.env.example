# App
NODE_ENV=development
PORT=3000
TIMEZONE=Asia/Ho_Chi_Minh

# Database (Neon Postgres) — dùng POOLED connection (host có "-pooler") vì backend dùng
# pg_advisory_xact_lock (an toàn với transaction-mode pooling). Nhớ sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require

# JWT (self-signed) — secrets stay in env, NEVER in platform_config
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=1800
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=2592000

# Google OAuth CLIENT ID (verify ID token; cùng giá trị với VITE_GOOGLE_CLIENT_ID ở web).
# Giá trị thật đặt ở backend/.env (local) hoặc .env.local (docker) — file .example chỉ là mẫu.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Webhook / postback signing secrets
IAP_WEBHOOK_SECRET=change-me-iap-webhook-secret
OFFERWALL_POSTBACK_SECRET=change-me-offerwall-secret

# Lootably offerwall — Publisher Dashboard → placement → tab "API" (key + placementID) và Postback settings (secret).
# Trống → shop hiển thị offer tĩnh (demo). Đặt Postback URL ở Lootably trỏ về /api/v1/webhooks/offerwall/lootably.
LOOTABLY_API_KEY=
LOOTABLY_PLACEMENT_ID=
LOOTABLY_POSTBACK_SECRET=

# Cloudflare R2 (S3-compatible) — server-proxy image upload
R2_ACCOUNT_ID=64ac5adba6948d20f41fbd7ea152427e
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cdn-dev
R2_PUBLIC_BASE_URL=
