server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # API → backend (BACKEND_ORIGIN do env quyết định; giữ nguyên prefix /api/v1).
  # Lazy-resolve qua biến + resolver Docker (127.0.0.11) → nginx KHÔNG crash nếu backend
  # chưa lên / khác network; chỉ 502 lúc request. proxy_pass biến cần nối $request_uri thủ công.
  location /api/ {
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $fdv_upstream ${BACKEND_ORIGIN};
    proxy_pass $fdv_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # tài nguyên build hash → cache dài
  location /assets/ {
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # SPA fallback + KHÔNG cache config.js/index.html (thay đổi mỗi lần deploy/đổi env).
  # Nếu cache, đổi env (vd googleClientId) hay bundle mới sẽ bị CDN/browser che bằng bản cũ.
  # /assets/ (hash trong tên file) vẫn cache dài ở location riêng phía trên.
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store, must-revalidate" always;
  }
}
