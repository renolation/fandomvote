# API base — qua Vite proxy (/api → http://localhost:3000). Prod: đặt full URL.
VITE_API_BASE_URL=/api/v1
# Google OAuth CLIENT ID — KHÔNG phải client secret (secret dạng GOCSPX-... tuyệt đối không để ở web).
# Đúng định dạng: <số>-<hash>.apps.googleusercontent.com. PHẢI giống GOOGLE_CLIENT_ID ở backend.
# Giá trị thật đặt ở web/.env (gitignored) cho dev; docker dùng GOOGLE_CLIENT_ID ở .env.local.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
